# ───────────────────────────────────────────────────────────────
# AKILI server — copy to `.env` and fill in. NEVER commit `.env`.
# Generate long random secrets with:  openssl rand -hex 48
#   (or)  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ───────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development            # development | production | test

# Public address of the website (used in verification / reset-password emails)
FRONTEND_URL=

# Browsers allowed to call this API. Comma-separated, EXACT origins, no "*".
# Required when NODE_ENV=production.
ALLOWED_ORIGINS=

# How many reverse proxies sit in front of the API (Render/Railway/Nginx = 1).
# Needed so rate limits and logs see the real visitor IP, not the proxy.
TRUST_PROXY=0

# ── Database (Neon / any PostgreSQL) ───────────────────────────
DATABASE_URL=

# ── Login tokens (must be different from each other, 32+ chars) ─
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Brevo) ──────────────────────────────────────────────
BREVO_API_KEY=
MAIL_FROM_NAME=
MAIL_FROM_EMAIL=
LOGO_URL=https://res.cloudinary.com/dtc6rzefb/image/upload/v1777514277/AKILI_ggwowz.jpg

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────
MPESA_ENV=sandbox               # sandbox until the owner approves going live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379          # sandbox shortcode; use your real Paybill/Till live
MPESA_PASSKEY=

# Paystack (card / mobile money). Leave empty to switch it off. This is the SECRET key (sk_test_... or sk_live_...);
# never use the public key (pk_...) and never share or commit this value. Webhook: <API>/api/v1/paystack/webhook
PAYSTACK_SECRET_KEY=

# Secret that is appended to every URL Safaricom calls (32+ chars; letters, digits, - and _ only).
# Anyone who does not know it gets a 404.
MPESA_CALLBACK_SECRET=

# Public URLs of THIS server WITHOUT the secret (the code adds /<secret> itself).
MPESA_CALLBACK_URL=
MPESA_C2B_VALIDATION_URL=
MPESA_C2B_CONFIRMATION_URL=

# Optional: only accept callbacks from these IPs (comma-separated).
# Copy the current list from Safaricom's Daraja documentation. Empty = check disabled.
MPESA_ALLOWED_IPS=

# false (default): Paybill payments with no STK request wait for an admin to approve.
# true: auto-unlock when TransID is new, amount and sender phone match exactly.
MPESA_C2B_AUTO_CONFIRM=false

# Paybill (default) or Till. For a Till set CustomerBuyGoodsOnline and put the till number in MPESA_PARTY_B.
# Note: customers paying a Till directly cannot enter an account number, so Paybill is needed for C2B matching.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=

# ── SMS codes for phone sign-up / login (Africa's Talking) ─────
# console = prints the code in the server log (development only; never for real users)
SMS_PROVIDER=console             # console | africastalking
AT_ENV=sandbox                   # sandbox messages show only in the Africa's Talking simulator
AT_USERNAME=sandbox              # "sandbox" for the sandbox app, your app username for production
AT_API_KEY=
AT_SENDER_ID=                    # production only, must be approved by Africa's Talking
# Hard stop on texts sent per rolling 24 hours across the whole site (SMS costs money)
OTP_DAILY_SMS_CAP=300

# ── Parent gate ────────────────────────────────────────────────
# false while the website has no gate dialog yet; set TRUE once it ships. (If unset the server assumes true.) true = payments, PIN changes, screen time, export and delete need the parent to
# re-enter their password / an SMS code. Set false ONLY while the website is not yet updated to ask for it.
PARENT_GATE_REQUIRED=false
